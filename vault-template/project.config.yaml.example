# Project Memory System — Configurazione Progetto
#
# Copia questo file come project.config.yaml e compila i campi.
# Questo file viene letto automaticamente dalle skill.
# Non committare questo file su git se il repo_path contiene path assoluti
# specifici della tua macchina (aggiungilo al .gitignore del vault).

project_name: my-project          # nome del progetto (usato nei tag e negli indici)
repo_path: /path/to/your/repo     # path assoluto del repository git
vault_path: /path/to/your/vault   # path assoluto del vault Obsidian
language: italiano                 # italiano | english
